# Force LF everywhere: authored on Windows, executed on Linux (Lambda, CI).
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.tf    text eol=lf
*.tfvars text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
*.html  text eol=lf

*.zip binary
*.png binary
